<launch>
  <arg name="device" default="/dev/video3"/>
  <arg name="fps" default="30"/>
  <arg name="width" default="320"/>
  <arg name="height" default="240"/>

  <node namespace="" name="ov5645_mipi" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera_mipi"/>
    <param name="camera_frame" value="camera_link_optical"/>
    <param name="camera_info_url" value="package://b3rb_bringup/config/ov5645.ini"/>
    <param name="gscam_config" value="v4l2src device=$(var device) ! video/x-raw,format=BGRx,framerate=$(var fps)/1,width=$(var width),height=$(var height) ! imxvideoconvert_g2d rotation=2 ! video/x-raw,format=BGRx,framerate=$(var fps)/1,width=$(var width),height=$(var height) ! videoconvert ! video/x-raw,format=BGR"/>
    <param name="frame_id" value="camera_link_optical"/>
    <param name="sync_sink" value="true"/>
    <remap from="camera/image_raw" to="camera_mipi/image_raw"/>
    <remap from="camera/image_raw/compressed" to="camera_mipi/image_raw/compressed"/>
    <remap from="camera/camera_info" to="camera_mipi/camera_info"/>
  </node>

  <arg name="device_2" default="/dev/video4"/>
  <arg name="fps_2" default="30"/>
  <arg name="width_2" default="640"/>
  <arg name="height_2" default="360"/>

  <node namespace="" name="logi_cam" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera_logi"/>
    <param name="camera_frame" value="camera_link_optical_2"/>
    <param name="camera_info_url" value="None"/>
    <param name="gscam_config" value="v4l2src device=$(var device_2) ! image/jpeg,framerate=$(var fps_2)/1,width=$(var width_2),height=$(var height_2) ! jpegdec ! videoconvert ! video/x-raw,format=BGR"/>
    <param name="frame_id" value="camera_link_optical_2"/>
    <param name="sync_sink" value="true"/>
    <remap from="camera/image_raw" to="camera_logi/image_raw"/>
    <remap from="camera/image_raw/compressed" to="camera_logi/image_raw/compressed"/>
    <remap from="camera/camera_info" to="camera_logi/camera_info"/>
  </node>
</launch>
